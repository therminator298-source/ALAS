# ─────────────────────────────────────────────
#  ALAS — Variables de entorno (ejemplo)
#  Copiar como .env y completar los valores reales.
#  NUNCA commitear el .env real al repositorio.
# ─────────────────────────────────────────────

# Puerto en que escucha el servidor Express.
PORT=3000

# CORS: orígenes externos permitidos para consumir la API.
# Si el frontend se sirve DESDE ESTE MISMO servidor → dejar vacío.
# Si usás un frontend en otro dominio/puerto → listar separados por coma.
# Ejemplo: CORS_ORIGINS=https://mi-app.com,https://staging.mi-app.com
# ⚠️  NO usar "*" en producción: permite peticiones desde cualquier origen.
CORS_ORIGINS=

# X-Frame-Options / Content-Security-Policy frame-ancestors.
# "self" solo permite embebido desde el propio dominio.
# Cambiar a "none" para prohibir cualquier iframe.
FRAME_ANCESTORS=self

# ─── Base de datos MySQL ───────────────────────
MYSQL_HOST=172.17.10.101
MYSQL_PORT=3306
MYSQL_USER=logistica
# ⚠️  Usar una contraseña fuerte en producción. Nunca la del .env.example.
MYSQL_PASSWORD=colocar_password_localmente
# Conexiones simultáneas máximas al pool. Ajustar según carga esperada.
MYSQL_CONNECTION_LIMIT=10

# Bases de datos utilizadas por la aplicación.
MYSQL_ACUSE_DATABASE=BD_ALAS_ACUSE
MYSQL_SAP_DATABASE=BD_ALAS_SAP

# ─── Comportamiento de la aplicación ──────────
# Usuario que aparece cuando nadie está logueado.
ACUSE_DEFAULT_USER=Operador General

# Nombres de estado tal como están definidos en el ENUM de la BD.
# Verificar contra: BD_ALAS_ACUSE.acuse.Estado
ACUSE_ESTADO_HOY=hoy
ACUSE_ESTADO_PROXIMA=proxima
ACUSE_ESTADO_COMPLETADO=completado
