# Config de PRUEBA (modo `--mode test`). Valores falsos a propósito: el script
# scripts/verify-calendar-mobile.mjs intercepta todas las llamadas y responde
# con datos fijos. No sirve para desarrollar contra datos reales — para eso
# copiá .env.example a .env.local.
VITE_CAL_SUPABASE_URL=https://test-calendario.supabase.co
VITE_CAL_SUPABASE_ANON_KEY=test-anon-key
VITE_REQUIRE_ALAS_SSO=false
