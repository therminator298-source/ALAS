# Copiá este archivo como .env.local y completá con los valores de cada proyecto Supabase.
# ⚠️ SOLO la anon public key. NUNCA la service_role en el cliente: Vite compila
#    toda variable VITE_* dentro del bundle y queda visible en el navegador.

# ── Incidencias de Recepción ──
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...

# ── Calendario de tareas ──
# Sin estas dos el Calendario arranca en modo demo y muestra el cartel amarillo
# "No hay conexión con la base": lo que se cargue NO se guarda.
# La tabla `tareas` se instala con db/calendario_setup_en_acuses.sql.
VITE_CAL_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_CAL_SUPABASE_ANON_KEY=eyJ...anon...

# ── Acuses ──
# Si se omiten, AcusesView cae a los valores por defecto del código.
VITE_ACUSE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_ACUSE_SUPABASE_ANON_KEY=eyJ...anon...

# ── SSO del Launcher ALAS ──
VITE_LAUNCHER_URL=https://launcher-tawny.vercel.app
VITE_ALAS_MODULE_KEY=calendario
VITE_ALAS_SSO_VERIFY_URL=https://xkgumqztscqcwamtimuh.supabase.co/functions/v1/verify-sso-token
VITE_ALAS_SSO_VERIFY_ANON_KEY=eyJ...anon...launcher...

# En producción se exige SSO por defecto. Usar false solo para desarrollo local.
VITE_REQUIRE_ALAS_SSO=true
